# Default four-GPU H200 topology: two GPUs for prefill and two for decode.
# The harness fails early if the model cannot be loaded with TP=2; callers can
# add another explicit profile without changing the launcher.
EXPECTED_GPU_NAME=H200
GPUQ_GPUS=4
PREFILL_TP=2
PREFILL_BASE_GPU_ID=0
DECODE_TP=2
DECODE_BASE_GPU_ID=2
